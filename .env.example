# Copy this file to .env.local and paste your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Standard route ( / ) models ---
GEMINI_DETECT_PDF_MODEL=gemini-2.5-flash
GEMINI_GENERATE_REPLIES_MODEL=gemini-2.5-flash

# --- PS route ( /ps ) models ---
GEMINI_PS_DETECT_PDF_MODEL=gemini-2.5-flash
GEMINI_PS_GENERATE_REPLIES_MODEL=gemini-2.5-flash

# --- Dua Urdu route ( /dua-urdu ) models ---
GEMINI_DUA_URDU_DETECT_PDF_MODEL=gemini-2.5-flash
GEMINI_DUA_URDU_GENERATE_REPLIES_MODEL=gemini-2.5-flash

# --- PS Urdu route ( /ps-urdu ) models ---
# When unset, these inherit the matching Dua Urdu model setting.
GEMINI_PS_URDU_DETECT_PDF_MODEL=gemini-2.5-flash
GEMINI_PS_URDU_GENERATE_REPLIES_MODEL=gemini-2.5-flash

# --- Argon 4 buttons (all routes) ---
# Used only by the "Argon 4 Medium/High" generate buttons. Does not fall back to GEMINI_MODEL.
GEMINI_ARGON_MODEL=gemini-4-argon

# Optional inactivity timeout for Gemini response headers/stream chunks (default: 20 minutes).
GEMINI_REQUEST_TIMEOUT_MS=1200000

# Optional: set to true only when debugging. This logs prompts and full PDF base64 request bodies.
DEBUG_GEMINI_REQUESTS=false
